<?xml version="1.0" encoding="utf-8" ?>
<!-- SpatialNavRoot — drop your focusables inside it and LRUD navigation just works
     for the whole subtree (the rough equivalent of react-tv-space-navigation's
     <SpatialNavigationRoot>). Arrow keys bubble up here from the focused leaf;
     keys it doesn't consume bubble past to your scene (so you handle Back, etc.,
     normally). Open a trapped sub-scope (modal/sheet) with sendFocusTo /
     releaseFocus. -->
<component name="SpatialNavRoot" extends="Group">
    <interface>
        <!-- Land initial focus (call once after your UI is built). -->
        <function name="focusDefault" />
        <!-- Open a trapped sub-scope over a node (e.g. a modal). Pass the node. -->
        <function name="sendFocusTo" />
        <!-- Close the top sub-scope and restore focus underneath. -->
        <function name="releaseFocus" />
        <!-- Rebuild the base scope after adding/removing focusables at runtime. -->
        <function name="refresh" />
    </interface>
</component>
