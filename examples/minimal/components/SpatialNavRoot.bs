import "pkg:/source/SpatialNav.bs"

' SpatialNavRoot — container that owns LRUD navigation for its subtree.
'
' Focus is a STACK of scopes: the base is this root's subtree; sendFocusTo() pushes
' a trapped sub-scope (a modal/sheet) so arrows can't reach what's underneath, and
' releaseFocus() pops it and restores focus to where the parent scope left off.
' Only the top scope is active. Scopes are built lazily and gather any descendant
' marked `spatialFocusable` (see SpatialNav.bs for the markers).

sub init()
    m.stack = invalid   ' [scope, ...]; top is active. Built on first use.
end sub

function activeScope() as object
    if m.stack = invalid or m.stack.count() = 0 then return invalid
    return m.stack[m.stack.count() - 1]
end function

sub ensureScope()
    if m.stack = invalid then m.stack = [SpatialNav.scope(m.top)]
end sub

' Rebuild the base scope (call after you add/remove focusables at runtime).
sub refresh()
    m.stack = [SpatialNav.scope(m.top)]
end sub

' Land focus on the declared spatialDefault (or the first focusable). Call once,
' after your UI exists.
sub focusDefault()
    ensureScope()
    SpatialNav.focusDefault(activeScope())
end sub

' Open a trapped sub-scope over `rootNode` (e.g. a modal). Focus moves inside it;
' arrows can no longer reach the scope below.
sub sendFocusTo(rootNode as object)
    ensureScope()
    m.stack.push(SpatialNav.scope(rootNode))
    SpatialNav.focusDefault(activeScope())
end sub

' Close the top sub-scope and restore focus to where the parent scope left off.
sub releaseFocus()
    if m.stack = invalid or m.stack.count() <= 1 then return
    m.stack.pop()
    parent = activeScope()
    if parent.current <> invalid
        SpatialNav.focus(parent, parent.current)
    else
        SpatialNav.focusDefault(parent)
    end if
end sub

' Arrow keys bubble up here from the focused leaf and drive the active scope.
' Anything else returns false and bubbles past to your scene (Back, etc.).
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    ensureScope()
    scope = activeScope()
    if scope <> invalid and SpatialNav.handleKey(scope, key) then return true
    return false
end function
